CREATE OR REPLACE VIEW CTSG_ENC.V_CTRY_PARTNER
(CTRY_CODE,IS_PARTNER)
AS
WITH SRC AS (
SELECT CTRY_CODE, 'Y' AS IS_PARTNER
FROM PTP_TAX_JRDT
WHERE OUT_DATE_STARTED IS NOT NULL
AND TRUNC(OUT_DATE_STARTED) <= TRUNC(SYSDATE)
AND (TRUNC(OUT_DATE_ENDED) >= TRUNC(SYSDATE) OR OUT_DATE_ENDED IS NULL)
)
SELECT C.CTRY_CODE, NVL2(S.IS_PARTNER, S.IS_PARTNER, 'N') AS IS_PARTNER
FROM PTP_ISO_COUNTRY C LEFT JOIN SRC S ON C.CTRY_CODE=S.CTRY_CODE
ORDER BY C.CTRY_CODE;
