Test Data:
Query 1 (run BEFORE the Batch):
SELECT RPT_YR, REC_JDX_CTRY, FCE_TIN
FROM ctsg_enc.V_EXT
WHERE FCE_TIN = '30211895'
  AND RPT_YR = '2025';

Query 2 (run AFTER the Batch):
SELECT M.MS_ID, M.RPT_YR, M.APRVD_STS, F.FCE_TIN, F.DOC_TYPE_IND, F.DOC_REF_ID, M.CREATED_AT
FROM ctsg_enc.GIR_MSG_SPEC M
JOIN ctsg_enc.FILING_INFO F ON F.MS_ID = M.MS_ID
WHERE F.FCE_TIN = '30211895'
  AND M.RPT_YR = '2025'
  AND TRUNC(M.CREATED_AT) = TRUNC(SYSDATE);

Query 3 (run AFTER the Batch):
WITH FI AS (
  SELECT F.FILING_INFO_ID
  FROM ctsg_enc.GIR_MSG_SPEC M
  JOIN ctsg_enc.FILING_INFO F ON F.MS_ID = M.MS_ID
  WHERE F.FCE_TIN = '30211895'
    AND M.RPT_YR = '2025'
    AND TRUNC(M.CREATED_AT) = TRUNC(SYSDATE)
)
SELECT 'FILING_INFO' AS ELEMENT, T.FILING_INFO_ID, T.DOC_REF_ID, T.DOC_TYPE_IND
FROM ctsg_enc.FILING_INFO T WHERE T.FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM FI)
UNION ALL
SELECT 'GEN_SEC', T.FILING_INFO_ID, T.DOC_REF_ID, T.DOC_TYPE_IND
FROM ctsg_enc.GEN_SEC T WHERE T.FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM FI)
UNION ALL
SELECT 'SMRY', T.FILING_INFO_ID, T.DOC_REF_ID, T.DOC_TYPE_IND
FROM ctsg_enc.SMRY T WHERE T.FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM FI)
UNION ALL
SELECT 'JDX_SEC', T.FILING_INFO_ID, T.DOC_REF_ID, T.DOC_TYPE_IND
FROM ctsg_enc.JDX_SEC T WHERE T.FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM FI)
UNION ALL
SELECT 'UTPR_ATTR', T.FILING_INFO_ID, T.DOC_REF_ID, T.DOC_TYPE_IND
FROM ctsg_enc.UTPR_ATTR T WHERE T.FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM FI)
ORDER BY 1;

Query 4 (run AFTER the Batch):
SELECT X.FILING_INFO_ID, X.FCE_TIN, X.PTP_FI_ID, P.FI_ID, P.DOC_TYPE_IND AS PTP_DOC_TYPE_IND
FROM ctsg_enc.FILING_INFO X
JOIN ptp_enc.PTP_FILING_INFO P ON P.FI_ID = X.PTP_FI_ID
WHERE X.FCE_TIN = '30211895';
