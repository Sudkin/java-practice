-- 這個 ZIP 與這個 MessageRefId 都還沒被處理過（預期 0 筆）
SELECT DP_ID, MSG_TYPE, ZIP_FILENAME, META_SNDR_FILE_ID
FROM ctsg_enc.CTS_DATA_PACKET
WHERE ZIP_FILENAME = '<新ZIP檔名>'
   OR META_SNDR_FILE_ID LIKE '%30155093-21102026Z01%';

-- 現有的 GIR status message（要記下有哪些 'P'）
SELECT STS_ID, STS_MSG_REF_ID, VAL_RSLT, SGD_STS
FROM ctsg_enc.CTS_STS_MSG
WHERE STS_MSG_REF_ID LIKE 'StatusHK%ID%'
ORDER BY STS_ID DESC;

-- 三表筆數（R1 後的現況，當作 R2 的「前」）
SELECT 'CTS_DATA_PACKET' AS T, COUNT(*) AS CNT FROM ctsg_enc.CTS_DATA_PACKET
UNION ALL SELECT 'CTS_STS_MSG', COUNT(*) FROM ctsg_enc.CTS_STS_MSG
UNION ALL SELECT 'CTS_TX_REC', COUNT(*) FROM ctsg_enc.CTS_TX_REC;

-- GIR_MSG_SPEC 的 SGD_STS 分布
SELECT SGD_STS, COUNT(*) AS CNT FROM ctsg_enc.GIR_MSG_SPEC GROUP BY SGD_STS;
