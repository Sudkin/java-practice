SELECT M.MS_ID, M.GIR_CNT, M.AMEND_CNT
FROM   ctsg_enc.GIR_MSG_SPEC M
WHERE  M.MS_ID = :ms_id;

-- FilingInfo 的 DocTypeIndic 分佈
SELECT DOC_TYPE_IND, COUNT(*) AS cnt
FROM   ctsg_enc.FILING_INFO
WHERE  MS_ID = :ms_id
GROUP  BY DOC_TYPE_IND;

-- 各 section 的 DocTypeIndic 分佈(035 / 036 用)
SELECT 'GEN_SEC' AS sec, DOC_TYPE_IND, COUNT(*) AS cnt FROM ctsg_enc.GEN_SEC
 WHERE FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM ctsg_enc.FILING_INFO WHERE MS_ID = :ms_id)
 GROUP BY DOC_TYPE_IND
UNION ALL
SELECT 'SMRY', DOC_TYPE_IND, COUNT(*) FROM ctsg_enc.SMRY
 WHERE FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM ctsg_enc.FILING_INFO WHERE MS_ID = :ms_id)
 GROUP BY DOC_TYPE_IND
UNION ALL
SELECT 'JDX_SEC', DOC_TYPE_IND, COUNT(*) FROM ctsg_enc.JDX_SEC
 WHERE FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM ctsg_enc.FILING_INFO WHERE MS_ID = :ms_id)
 GROUP BY DOC_TYPE_IND
UNION ALL
SELECT 'UTPR_ATTR', DOC_TYPE_IND, COUNT(*) FROM ctsg_enc.UTPR_ATTR
 WHERE FILING_INFO_ID IN (SELECT FILING_INFO_ID FROM ctsg_enc.FILING_INFO WHERE MS_ID = :ms_id)
 GROUP BY DOC_TYPE_IND;
